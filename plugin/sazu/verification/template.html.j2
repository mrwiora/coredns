{%- for row in tr.defects.rows %}
    <tr><td>{{ row.n }}</td><td>{{ row.summary }}</td><td>{{ row.impact }}</td><td>{{ row.resolution }}</td></tr>
{%- endfor %}
  </table></div>
</section>

<section id="tr-7">
  <h2><span class="secno">7</span> Conclusion and sign-off</h2>
{%- for p in tr.conclusion.paragraphs %}
