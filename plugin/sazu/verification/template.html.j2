  <div class="wrap"><table class="spec">
    <tr><th>Package</th><th>Guard</th><th>Reason</th></tr>
{%- for row in tr.skipped_tests.rows %}
    <tr><td class="mono">{{ row.package }}</td><td class="mono">{{ row.guard }}</td><td>{{ row.reason }}</td></tr>
{%- endfor %}
  </table></div>
  <p>{{ tr.skipped_tests.outro }}</p>
</section>

<section id="tr-5">
  <h2><span class="secno">5</span> Manual verification log</h2>
