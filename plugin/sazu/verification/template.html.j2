    <tr><th>#</th><th>Scenario</th><th>Outcome</th></tr>
{%- for row in tr.manual_verification_log.rows %}
    <tr><td>{{ row.n }}</td><td>{{ row.scenario }}</td><td>{{ row.outcome }}</td></tr>
{%- endfor %}
  </table></div>
</section>

<section id="tr-6">
  <h2><span class="secno">6</span> Defects found and resolved during development</h2>
