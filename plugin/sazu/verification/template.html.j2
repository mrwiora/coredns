{%- endfor %}
  <div class="wrap"><table class="spec">
    <tr><th>Field</th><th>Value</th></tr>
{%- for row in tr.conclusion.signoff %}
    <tr><td>{{ row.field }}</td><td>{{ row.value }}</td></tr>
{%- endfor %}
  </table></div>
</section>

  </main>
</div>

<footer class="docfoot">{{ title }} &middot; generated from <code class="inline">{{ branch }} @ {{ commit }}</code> &middot; a private working document, not an RFC submission.</footer>

<script>
(function () {
  var tabs = document.querySelectorAll('.doc-tabs button');
  var wraps = { req: document.querySelector('.shell.layout'), test: document.getElementById('wrap-test'), report: document.getElementById('wrap-report') };
  // Scroll to just above the sticky tab bar itself, not to a section
  // inside the document that's just been un-hidden. .doc-tabs's
  // offsetTop is a fixed layout position -- it doesn't move when the
  // content below it is hidden/shown -- so this needs no deferral and
  // no per-document target list, and it's what the original
  // hand-maintained dossier did before this generator existed.
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.setAttribute('aria-selected', b === btn ? 'true' : 'false'); });
      Object.keys(wraps).forEach(function (k) { wraps[k].hidden = (k !== btn.dataset.doc); });
      window.scrollTo({ top: document.querySelector('.doc-tabs').offsetTop - 8, behavior: 'instant' in window ? 'instant' : 'auto' });
    });
  });
})();
</script>
